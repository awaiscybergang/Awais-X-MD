{
  "name": "awais-x-md",
  "version": "2.1.0",
  "description": "AWAIS X MD - open-source multi-device WhatsApp bot for Node.js (Baileys 6.7.18) with 167 commands: Gemini AI chat, YouTube/TikTok/Instagram/Facebook/Twitter/MediaFire downloaders, Quran/Hadith/Dua/prayer times, anti-delete/anti-edit/anti-link, group management and stickers. Telegram, Terminal or Web Pair modes. Termux and VPS ready.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "terminal": "node index.js --terminal",
    "telegram": "node index.js --telegram",
    "web": "node index.js --web",
    "setup": "node index.js --setup",
    "menu": "node index.js --menu",
    "forever": "bash start.sh",
    "dev": "node index.js",
    "add": "node index.js --terminal --add",
    "bg": "bash run247.sh",
    "stop": "bash run247.sh stop",
    "logs": "bash run247.sh logs"
  },
  "keywords": [
    "whatsapp-bot",
    "whatsapp-bot-termux",
    "whatsapp-md",
    "multi-device",
    "baileys",
    "baileys-bot",
    "nodejs-whatsapp-bot",
    "awais-x-md",
    "awais-md",
    "gemini-ai",
    "whatsapp-gemini-bot",
    "youtube-downloader",
    "tiktok-downloader",
    "instagram-downloader",
    "islamic-bot",
    "quran",
    "telegram-pairing",
    "web-pair",
    "pairing-website",
    "termux",
    "free-vps",
    "pm2",
    "anti-delete",
    "group-management",
    "media-downloader",
    "whatsapp-sticker-bot",
    "awais-x-md-2026",
    "whatsapp-bot-2026",
    "termux-whatsapp-bot",
    "whatsapp-bot-telegram",
    "whatsapp-pairing-code"
  ],
  "author": "Awais X Dev (Awais Mayo Hacker)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaiscybergang/Awais-X-MD.git"
  },
  "bugs": {
    "url": "https://github.com/awaiscybergang/Awais-X-MD/issues"
  },
  "homepage": "https://github.com/awaiscybergang/Awais-X-MD#readme",
  "dependencies": {
    "@whiskeysockets/baileys": "~6.7.18",
    "node-telegram-bot-api": "^0.66.0",
    "express": "^4.21.2",
    "pino": "^9.4.0",
    "dotenv": "^16.4.5",
    "axios": "^1.7.7",
    "yt-search": "^2.12.2",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
