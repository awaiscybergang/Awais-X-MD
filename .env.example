# ═══════════════════════════════════════════════
#  AWAIS X MD - Environment Variables
#  Copy:  cp .env.example .env   then edit .env
#  (or just run: npm start  - the launcher menu creates and fills .env for you)
# ═══════════════════════════════════════════════

# [MODE] telegram | terminal | web
# telegram = multi-user Telegram bot panel
# terminal = personal use, no Telegram bot
# web      = professional pairing website (multiple users pair from browser)
# (the launcher menu sets this for you; open it any time with: npm run setup)
# BOT_MODE=telegram

# [Terminal mode] Your WhatsApp number for the pairing code (country code, no +)
# WHATSAPP_NUMBER=923xxxxxxxxx

# [Terminal mode] Max numbers on one device at the same time (default 5)
# MAX_NUMBERS=5

# [All modes] If some numbers never finish linking ("Logging in..." on the phone, then nothing), set this to web: the bot then
# uses the CURRENT WhatsApp Web version (it also switches to it by itself after 2 pairing codes without a login).
# WA_VERSION_SOURCE=web

# [Telegram mode] Max users that can link a WhatsApp at the same time (default 30; each uses about 70-100 MB RAM)
# MAX_TELEGRAM_USERS=30

# [Web Pair mode] Max numbers connected at the same time (default 30) and anti-spam limits per hour (defaults 8 / 6)
# MAX_WEB_SESSIONS=30
# WEB_MAX_PER_IP_HOUR=8
# WEB_MAX_PER_NUMBER_HOUR=6

# [Telegram mode only] Telegram Bot Token (get it free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [Telegram mode] Your Telegram Chat ID (the person who owns this bot). Required for security.
# How to get it: open Telegram, search @userinfobot or @getidsbot, start chat, it will reply your ID (numbers only).
# Then open YOUR bot once and press Start, otherwise it cannot send you messages.
# TELEGRAM_OWNER_CHAT_ID=123456789

# [Web Pair mode] Port for the pairing website (default 3000)
# WEB_PORT=3000

# [OPTIONAL] Owner WhatsApp number with country code, no "+"  (e.g. 923xxxxxxxxx / 91xxxxxxxxxx)
OWNER_NUMBER=923xxxxxxxxx

# [OPTIONAL] Google Gemini API key for .ai .gpt .gemini .ask  (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Force a specific Gemini model name
# GEMINI_MODEL=

# [OPTIONAL] Custom ffmpeg path (Termux/VPS auto-detects system ffmpeg, usually not needed)
# FFMPEG_PATH=
